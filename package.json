{
  "name": "agy-connector-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "check:package": "node scripts/check-package.mjs",
    "probe:agy": "tsx scripts/probe-agy.ts",
    "evaluate:agy": "tsx scripts/evaluate-agy.ts",
    "format:check": "prettier --check src tests scripts integrations .github package.json tsconfig.json vitest.config.ts",
    "verify:isolation": "tsx scripts/verify-isolation.ts",
    "verify:modes": "tsx scripts/verify-modes.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "remark-frontmatter": "5.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "prettier": "3.10.1",
    "tar": "7.5.23",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
